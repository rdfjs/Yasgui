{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "removeComments": true,
    "sourceMap": true,
    "listFiles": false,
    "outDir": "./build/ts",
    "rootDir": ".",
    "paths": {
      "@rdfjs/sparql-studio": ["./packages/sparql-studio/src"],
      "@rdfjs/sparql-utils": ["./packages/sparql-utils/src"],
      "@rdfjs/sparql-editor-monaco": ["./packages/sparql-editor-monaco/src"],
      "@rdfjs/sparql-editor-codemirror": ["./packages/sparql-editor-codemirror/src"],
      "@rdfjs/sparql-results": ["./packages/sparql-results/src"]
    }
  },
  "files": ["./packages/sparql-studio/typings-custom/main.d.ts", "./vite-env.d.ts"],
  "include": ["./packages/*/src/**/**/*", "./test/*"],
  "compileOnSave": false,
  "exclude": ["**/build/**"]
}
